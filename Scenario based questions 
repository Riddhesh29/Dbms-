P10 Trigger (MySQL)
SQL
CREATE TABLE Emp(
    Emp_no INT PRIMARY KEY,
    Emp_name VARCHAR(50),
    Emp_salary DECIMAL(10,2)
);

CREATE TABLE Tracking(
    Emp_no INT,
    Emp_salary DECIMAL(10,2)
);
Insert Trigger
SQL
DELIMITER //

CREATE TRIGGER trg_insert_salary
AFTER INSERT ON Emp
FOR EACH ROW
BEGIN
    IF NEW.Emp_salary < 50000 THEN
        INSERT INTO Tracking
        VALUES(NEW.Emp_no, NEW.Emp_salary);
    END IF;
END //

DELIMITER ;
Update Trigger
SQL
DELIMITER //

CREATE TRIGGER trg_update_salary
AFTER UPDATE ON Emp
FOR EACH ROW
BEGIN
    IF NEW.Emp_salary < 50000 THEN
        INSERT INTO Tracking
        VALUES(NEW.Emp_no, NEW.Emp_salary);
    END IF;
END //

DELIMITER ;
Delete Trigger
SQL
DELIMITER //

CREATE TRIGGER trg_delete_salary
AFTER DELETE ON Emp
FOR EACH ROW
BEGIN
    INSERT INTO Tracking
    VALUES(OLD.Emp_no, OLD.Emp_salary);
END //

DELIMITER ;
